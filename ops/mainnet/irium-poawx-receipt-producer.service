[Unit]
Description=Irium mainnet PoAW-X pending receipt producer
After=iriumd.service
Wants=iriumd.service

[Service]
Type=simple
Environment=IRIUM_NODE_RPC=http://127.0.0.1:38300
ExecStart=/home/irium/mainnet/bin/poawx-receipt-producer.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
